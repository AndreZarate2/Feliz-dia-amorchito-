<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Feliz Día de la Novia · Mi Universo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500;1,600&family=Marcellus&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --void: #04010c;
    --deep2: #150a2b;
    --deep3: #2a1147;
    --rose: #ff5d8f;
    --rose-soft: #ffb3c9;
    --gold: #f2c879;
    --lavender: #cdb4f2;
    --paper: #fdf3ff;
    --muted: #b9a8d6;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{
    height:100%;
    background:var(--void);
    overflow:hidden;
    font-family:'Quicksand', sans-serif;
    color:var(--paper);
  }

  body{
    position:relative;
    width:100%;
    height:100vh;
  }

  /* ================= BACKGROUND ================= */
  #bg{
    position:fixed; inset:0;
    background:
      radial-gradient(ellipse 60% 45% at 18% 20%, rgba(255,93,143,0.16), transparent 60%),
      radial-gradient(ellipse 55% 50% at 85% 78%, rgba(205,180,242,0.16), transparent 60%),
      radial-gradient(ellipse 80% 70% at 50% 50%, var(--deep3) 0%, var(--deep2) 45%, var(--void) 100%);
    z-index:0;
  }
  .nebula{
    position:fixed; border-radius:50%;
    filter:blur(70px);
    opacity:0.35;
    z-index:0;
    animation: drift 26s ease-in-out infinite alternate;
  }
  .nebula.n1{ width:38vw; height:38vw; top:-8vw; left:-10vw; background:radial-gradient(circle, #ff5d8f, transparent 70%); }
  .nebula.n2{ width:32vw; height:32vw; bottom:-10vw; right:-6vw; background:radial-gradient(circle, #cdb4f2, transparent 70%); animation-delay:4s; }
  @keyframes drift{ from{ transform:translate(0,0) scale(1);} to{ transform:translate(2vw,3vw) scale(1.08);} }

  #stars{ position:fixed; inset:0; z-index:1; pointer-events:none; }
  .star{
    position:absolute; background:var(--paper); border-radius:50%;
    animation: twinkle linear infinite;
    opacity:0.4;
  }
  @keyframes twinkle{
    0%,100%{ opacity:0.15; }
    50%{ opacity:0.95; }
  }
  .shooting{
    position:absolute;
    width:2px; height:2px;
    background:var(--paper);
    border-radius:50%;
    box-shadow: 0 0 8px 2px rgba(255,255,255,0.9);
    opacity:0;
    animation: shoot 7s linear infinite;
  }
  .shooting::before{
    content:''; position:absolute; top:0; left:0;
    width:120px; height:1px;
    background:linear-gradient(90deg, rgba(255,255,255,0.9), transparent);
    transform-origin: left center;
    transform: rotate(180deg) translateX(1px);
  }
  @keyframes shoot{
    0%{ opacity:0; transform:translate(0,0); }
    2%{ opacity:1; }
    18%{ opacity:0; transform:translate(-38vw, 24vh); }
    100%{ opacity:0; }
  }

  /* ================= SCENE WRAPPER ================= */
  .scene{
    position:relative; z-index:2;
    width:100%; height:100vh;
  }

  /* ================= SCREEN 1 : INTRO ================= */
  #intro{
    position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center;
    padding:6vw;
    transition: opacity 0.9s ease, filter 0.9s ease, transform 0.9s ease;
  }
  #intro.hide{
    opacity:0;
    filter:blur(10px);
    transform: scale(0.92);
    pointer-events:none;
  }
  .intro-card{
    text-align:center;
    max-width:640px;
  }
  .eyebrow{
    font-family:'Quicksand', sans-serif;
    letter-spacing:0.45em;
    text-transform:uppercase;
    font-size:0.7rem;
    color:var(--gold);
    opacity:0;
    animation: riseIn 1s ease forwards;
    animation-delay:0.1s;
  }
  .intro-heart-mark{
    margin:1.1rem auto 0.6rem;
    width:34px; height:34px;
    opacity:0;
    animation: riseIn 1s ease forwards;
    animation-delay:0.25s;
  }
  .headline{
    font-family:'Cormorant Garamond', serif;
    font-weight:600;
    font-style:italic;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height:1.05;
    background: linear-gradient(180deg, #fff 10%, var(--rose-soft) 55%, var(--gold) 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    opacity:0;
    animation: riseIn 1s ease forwards;
    animation-delay:0.4s;
  }
  .subline{
    margin-top:1.1rem;
    font-size:1.02rem;
    color:var(--muted);
    letter-spacing:0.02em;
    opacity:0;
    animation: riseIn 1s ease forwards;
    animation-delay:0.6s;
  }
  .date-chip{
    display:inline-block;
    margin-top:1.6rem;
    padding:0.4rem 1.1rem;
    border:1px solid rgba(242,200,121,0.4);
    border-radius:999px;
    font-size:0.75rem;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--gold);
    opacity:0;
    animation: riseIn 1s ease forwards;
    animation-delay:0.75s;
  }
  @keyframes riseIn{
    from{ opacity:0; transform:translateY(14px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .explore-btn{
    margin-top:2.6rem;
    display:inline-flex;
    align-items:center;
    gap:0.6rem;
    padding:0.95rem 2.1rem;
    border-radius:999px;
    border:1px solid rgba(255,255,255,0.18);
    background: linear-gradient(135deg, rgba(255,93,143,0.9), rgba(205,180,242,0.85));
    color:#1a0a26;
    font-family:'Quicksand', sans-serif;
    font-weight:600;
    font-size:0.95rem;
    letter-spacing:0.03em;
    cursor:pointer;
    box-shadow: 0 10px 40px -10px rgba(255,93,143,0.55);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    opacity:0;
    animation: riseIn 1s ease forwards;
    animation-delay:0.95s;
  }
  .explore-btn:hover{
    transform:translateY(-3px) scale(1.03);
    box-shadow: 0 16px 50px -8px rgba(255,93,143,0.7);
  }
  .explore-btn:active{ transform:translateY(0) scale(0.98); }
  .explore-btn svg{ transition:transform 0.35s ease; }
  .explore-btn:hover svg{ transform:translateX(4px); }

  /* ================= SCREEN 2 : UNIVERSE ================= */
  #universe{
    position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center;
    opacity:0;
    pointer-events:none;
    transition: opacity 1s ease;
  }
  #universe.show{
    opacity:1;
    pointer-events:auto;
  }

  .stage{
    position:relative;
    width:min(94vw, 94vh, 980px);
    aspect-ratio:1/1;
    display:flex; align-items:center; justify-content:center;
  }

  .top-line, .bottom-line{
    position:absolute;
    left:50%; transform:translateX(-50%);
    text-align:center;
    width:min(90%, 640px);
    opacity:0;
    transition: opacity 1.1s ease, transform 1.1s ease;
  }
  .top-line{ top:2%; }
  .bottom-line{ bottom:2%; }
  #universe.show .top-line{ opacity:1; transform:translateX(-50%) translateY(0); transition-delay:0.5s; }
  #universe.show .bottom-line{ opacity:1; transform:translateX(-50%) translateY(0); transition-delay:0.7s; }
  .top-line{ transform:translateX(-50%) translateY(-10px); }
  .bottom-line{ transform:translateX(-50%) translateY(10px); }

  .for-text{
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-weight:500;
    font-size: clamp(1rem, 2.4vw, 1.4rem);
    color:var(--rose-soft);
    letter-spacing:0.02em;
  }
  .universo-text{
    font-family:'Marcellus', serif;
    font-size: clamp(1.6rem, 4.4vw, 2.6rem);
    letter-spacing:0.22em;
    text-transform:uppercase;
    background:linear-gradient(180deg, var(--gold), var(--rose-soft));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }

  /* ---- Heart Sun (pseudo-3D) ---- */
  .heart-wrap{
    position:relative;
    width:15%; aspect-ratio:1/1;
    perspective:900px;
    z-index:5;
  }
  .heart-glow{
    position:absolute; inset:-70%;
    background: radial-gradient(circle, rgba(255,93,143,0.55) 0%, rgba(255,93,143,0.18) 35%, transparent 68%);
    filter: blur(6px);
    animation: pulseGlow 3.6s ease-in-out infinite;
    pointer-events:none;
  }
  @keyframes pulseGlow{
    0%,100%{ transform:scale(1); opacity:0.85; }
    50%{ transform:scale(1.14); opacity:1; }
  }
  .heart-3d{
    position:absolute; inset:0;
    transform-style:preserve-3d;
    animation: spinHeart 14s linear infinite;
  }
  @keyframes spinHeart{
    from{ transform:rotateY(0deg) rotateX(6deg); }
    to{ transform:rotateY(360deg) rotateX(6deg); }
  }
  .heart-layer{
    position:absolute;
    top:50%; left:50%;
    width:100%; height:100%;
    margin-top:-50%; margin-left:-50%;
  }
  .heart-layer::before, .heart-layer::after{
    content:"";
    position:absolute;
    width:50%; height:80%;
    top:16%;
    border-radius:50px 50px 0 0;
  }
  .heart-layer::before{ left:50%; transform:rotate(-45deg); transform-origin:0 100%; }
  .heart-layer::after{ left:0; transform:rotate(45deg); transform-origin:100% 100%; }

  .cta-glint{
    position:absolute; top:18%; left:32%;
    width:16%; height:16%;
    background:rgba(255,255,255,0.55);
    border-radius:50%;
    filter:blur(3px);
    z-index:6;
    animation: pulseGlow 3.6s ease-in-out infinite;
    pointer-events:none;
  }

  /* ---- Orbit rings (visual only) ---- */
  .ring{
    position:absolute;
    left:50%; top:50%;
    border:1px solid rgba(255,255,255,0.09);
    border-radius:50%;
    pointer-events:none;
  }

  /* ---- Orbiting phrase planets ---- */
  .planet{
    position:absolute;
    top:50%; left:50%;
    transform:translate(-50%,-50%);
    white-space:nowrap;
    font-family:'Quicksand', sans-serif;
    font-weight:600;
    font-size:0.82rem;
    letter-spacing:0.02em;
    padding:0.5rem 0.95rem;
    border-radius:999px;
    background:rgba(20,8,38,0.55);
    border:1px solid rgba(255,255,255,0.14);
    backdrop-filter: blur(4px);
    color:var(--paper);
    text-shadow:0 0 12px rgba(255,93,143,0.4);
    will-change: transform, opacity;
  }
  .planet .dot{
    display:inline-block;
    width:7px; height:7px;
    border-radius:50%;
    margin-right:0.45rem;
    vertical-align:middle;
    box-shadow:0 0 10px 2px currentColor;
  }

  .hint{
    position:absolute;
    bottom:-8%;
    left:50%; transform:translateX(-50%);
    font-size:0.68rem;
    letter-spacing:0.15em;
    text-transform:uppercase;
    color:var(--muted);
    opacity:0;
    transition:opacity 1s ease;
    transition-delay:1.4s;
    white-space:nowrap;
  }
  #universe.show .hint{ opacity:0.55; }

  /* ---- Music toggle ---- */
  .music-btn{
    position:fixed;
    top:5vw; right:5vw;
    z-index:20;
    width:50px; height:50px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,0.22);
    background: rgba(20,8,38,0.55);
    backdrop-filter: blur(6px);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    color:var(--paper);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .music-btn:hover{ transform:scale(1.08); border-color:rgba(255,255,255,0.4); }
  .music-btn svg{ width:20px; height:20px; }
  .music-btn.playing{
    border-color: rgba(255,93,143,0.6);
    box-shadow: 0 0 0 0 rgba(255,93,143,0.55);
    animation: musicPulse 2.2s ease-out infinite;
  }
  @keyframes musicPulse{
    0%{ box-shadow: 0 0 0 0 rgba(255,93,143,0.45); }
    70%{ box-shadow: 0 0 0 14px rgba(255,93,143,0); }
    100%{ box-shadow: 0 0 0 0 rgba(255,93,143,0); }
  }
  .icon-pause{ display:none; }
  .music-btn.playing .icon-play{ display:none; }
  .music-btn.playing .icon-pause{ display:block; }

  @media (max-width: 640px){
    .music-btn{ width:44px; height:44px; top:4vw; right:4vw; }
    .heart-wrap{ width:20%; }
    .planet{ font-size:0.68rem; padding:0.4rem 0.7rem; }
    .top-line{ top:1%; }
    .bottom-line{ bottom:1%; }
  }

  @media (prefers-reduced-motion: reduce){
    .heart-3d{ animation:none; transform:rotateY(20deg) rotateX(6deg); }
    .heart-glow, .cta-glint{ animation:none; }
    .star{ animation:none; opacity:0.6; }
    .nebula{ animation:none; }
    .shooting{ display:none; }
  }
</style>
</head>
<body>

  <div id="bg"></div>
  <div class="nebula n1"></div>
  <div class="nebula n2"></div>
  <div id="stars"></div>
  <div class="shooting" style="top:12%; left:70%; animation-delay:1s;"></div>
  <div class="shooting" style="top:30%; left:85%; animation-delay:5.2s;"></div>

  <audio id="bgMusic" src="1.mp3" loop preload="auto"></audio>
  <button class="music-btn" id="musicBtn" aria-label="Reproducir música">
    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
  </button>

  <div class="scene">

    <!-- ===== SCREEN 1 ===== -->
    <section id="intro">
      <div class="intro-card">
        <div class="eyebrow">1 de agosto</div>
        <svg class="intro-heart-mark" viewBox="0 0 32 29" fill="none">
          <path d="M16 28.5C16 28.5 1 19.5 1 9.6C1 4.6 5 1 9.5 1C12.6 1 15 2.7 16 5.3C17 2.7 19.4 1 22.5 1C27 1 31 4.6 31 9.6C31 19.5 16 28.5 16 28.5Z" fill="url(#g)"/>
          <defs><linearGradient id="g" x1="1" y1="1" x2="31" y2="28.5"><stop stop-color="#ff5d8f"/><stop offset="1" stop-color="#f2c879"/></linearGradient></defs>
        </svg>
        <h1 class="headline">Feliz Día<br>de la Novia</h1>
        <p class="subline">Para ti, mi amor. Hoy el mundo entero gira un poco más despacio, solo para celebrarte.</p>
        <span class="date-chip">Con todo mi cariño</span>
        <br>
        <button class="explore-btn" id="exploreBtn">
          Explorar más
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </button>
      </div>
    </section>

    <!-- ===== SCREEN 2 ===== -->
    <section id="universe">
      <div class="stage" id="stage">

        <div class="top-line">
          <p class="for-text">Para Nick, que es mi todo y mi</p>
        </div>

        <!-- rings drawn dynamically by JS -->

        <div class="heart-wrap">
          <div class="heart-glow"></div>
          <div class="heart-3d" id="heart3d"></div>
          <div class="cta-glint"></div>
        </div>

        <!-- planets injected by JS -->

        <div class="bottom-line">
          <p class="universo-text">Universo</p>
        </div>

      </div>
    </section>

  </div>

<script>
  // ---------- Background stars ----------
  const starsEl = document.getElementById('stars');
  const STAR_COUNT = 140;
  for(let i=0;i<STAR_COUNT;i++){
    const s = document.createElement('div');
    s.className = 'star';
    const size = Math.random()*2 + 0.6;
    s.style.width = size+'px';
    s.style.height = size+'px';
    s.style.left = (Math.random()*100)+'%';
    s.style.top = (Math.random()*100)+'%';
    s.style.animationDuration = (Math.random()*3 + 2)+'s';
    s.style.animationDelay = (Math.random()*4)+'s';
    starsEl.appendChild(s);
  }

  // ---------- Heart 3D layers (extruded) ----------
  const heart3d = document.getElementById('heart3d');
  const LAYERS = 26;
  for(let i=0;i<LAYERS;i++){
    const t = i/(LAYERS-1); // 0..1
    const z = (t-0.5) * 34; // depth spread
    const layer = document.createElement('div');
    layer.className = 'heart-layer';
    layer.style.transform = `translateZ(${z}px)`;
    // color shift from deep rose center to warm gold edges, like a sun
    const r = Math.round(255);
    const g = Math.round(70 + t*130);
    const b = Math.round(110 + (1-Math.abs(t-0.5)*2)*40);
    const color = `rgb(${r},${g},${b})`;
    layer.style.setProperty('--c', color);
    layer.querySelectorAll && (layer.style.color = color);
    const styleTag = document.createElement('style');
    heart3d.appendChild(layer);
  }
  // apply pseudo-element colors via a single stylesheet (can't set ::before bg inline per element easily otherwise)
  const styleSheet = document.createElement('style');
  let css = '';
  Array.from(heart3d.children).forEach((layer, i) => {
    const cls = 'hl-'+i;
    layer.classList.add(cls);
    const t = i/(LAYERS-1);
    const g = Math.round(70 + t*140);
    const b = Math.round(120 + (1-Math.abs(t-0.5)*2)*50);
    css += `.${cls}::before, .${cls}::after{ background: rgb(255,${g},${b}); box-shadow:0 0 ${10+t*10}px rgba(255,93,143,0.35); }`;
  });
  styleSheet.innerHTML = css;
  document.head.appendChild(styleSheet);

  // ---------- Orbit rings + planets ----------
  const stage = document.getElementById('stage');
  const phrases = [
    "Mi calma en la tormenta",
    "Mi risa favorita",
    "Mi hogar, sin importar el lugar",
    "Mi persona, siempre",
    "Mi paz",
    "Mi mejor decisión",
    "Mi lugar seguro",
    "Mi para siempre"
  ];
  const colors = ['#ff5d8f','#f2c879','#cdb4f2','#ff9fb8','#ffe08a','#b7a2e6','#ff7fa0','#e6c36b'];

  const planetsData = phrases.map((text, i) => {
    const ring = 16 + i * 9.2; // percentage radius, increasing like real orbits
    return {
      text,
      color: colors[i % colors.length],
      radiusX: ring,
      radiusY: ring * 0.52,
      speed: 0.15 + (i * 0.035), // closer orbits move faster
      angle: Math.random() * Math.PI * 2,
      dir: i % 2 === 0 ? 1 : -1
    };
  });

  // draw faint rings
  planetsData.forEach(p => {
    const ring = document.createElement('div');
    ring.className = 'ring';
    ring.style.width = (p.radiusX*2) + '%';
    ring.style.height = (p.radiusY*2) + '%';
    ring.style.marginLeft = -(p.radiusX) + '%';
    ring.style.marginTop = -(p.radiusY) + '%';
    stage.appendChild(ring);
  });

  // create planet elements
  const planetEls = planetsData.map(p => {
    const el = document.createElement('div');
    el.className = 'planet';
    el.style.color = p.color;
    el.innerHTML = `<span class="dot" style="background:${p.color}"></span>${p.text}`;
    stage.appendChild(el);
    return el;
  });

  let running = true;
  function animate(){
    if(running){
      const t = performance.now() / 1000;
      planetsData.forEach((p, i) => {
        const angle = p.angle + t * p.speed * p.dir;
        const x = 50 + Math.cos(angle) * p.radiusX;
        const y = 50 + Math.sin(angle) * p.radiusY;
        // depth illusion: nearer (larger sin) = bigger & brighter
        const depth = (Math.sin(angle) + 1) / 2; // 0..1
        const scale = 0.78 + depth * 0.4;
        const opacity = 0.55 + depth * 0.45;
        const z = Math.round(depth * 20);
        const el = planetEls[i];
        el.style.left = x + '%';
        el.style.top = y + '%';
        el.style.transform = `translate(-50%,-50%) scale(${scale})`;
        el.style.opacity = opacity;
        el.style.zIndex = z;
      });
    }
    requestAnimationFrame(animate);
  }
  requestAnimationFrame(animate);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduceMotion){ running = false; }

  // ---------- Music toggle ----------
  const bgMusic = document.getElementById('bgMusic');
  const musicBtn = document.getElementById('musicBtn');
  musicBtn.addEventListener('click', () => {
    if(bgMusic.paused){
      bgMusic.play().catch(() => {
        // El navegador puede bloquear el autoplay hasta la interacción; este click ya cuenta como una.
      });
      musicBtn.classList.add('playing');
    } else {
      bgMusic.pause();
      musicBtn.classList.remove('playing');
    }
  });
  bgMusic.addEventListener('ended', () => musicBtn.classList.remove('playing'));

  // ---------- Transition intro -> universe ----------
  const introEl = document.getElementById('intro');
  const universeEl = document.getElementById('universe');
  document.getElementById('exploreBtn').addEventListener('click', () => {
    introEl.classList.add('hide');
    setTimeout(() => {
      universeEl.classList.add('show');
    }, 350);
  });
</script>
</body>
</html>